# Copy to .env and fill values locally. Never commit .env.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=learn_app
MYSQL_PASSWORD=
MYSQL_DATABASE=my_appLearn
# Generate a private value with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_DYPNS_ENDPOINT=dypnsapi.aliyuncs.com
ALIYUN_SMS_TEMPLATE_REGISTER=100001
ALIYUN_SMS_TEMPLATE_RESET_PASSWORD=100003
BACKEND_CORS_ORIGINS=http://localhost:5174
